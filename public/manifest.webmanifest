{
  "name": "GlowStudio",
  "short_name": "GlowStudio",
  "description": "Crie vídeos de semijoias para o TikTok sem mostrar o rosto.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0B0B0F",
