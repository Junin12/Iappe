AddType application/manifest+json .webmanifest
Options -Indexes

<IfModule mod_headers.c>
  # Assets com hash no nome nunca mudam.
  <FilesMatch "\.(js|css|woff2?|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Vem depois para vencer: index, service worker e manifest sempre frescos (atualizações chegam na hora).
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Vitrine pública com endereço curto: /glowstudio/loja/nome-da-loja
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^loja/([a-z0-9-]+)/?$ loja.php?l=$1 [L,QSA]
</IfModule>
